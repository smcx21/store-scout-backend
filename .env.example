# Copy this file to .env and fill in your values. Never share .env.

# Required: your key from https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Optional: a password the extension must send (enter the same value in Store Scout settings)
API_TOKEN=

# Optional: Google product pages to open upfront per product (each costs 1 SerpAPI search).
# 0 = off: a store's direct link is fetched only when you click it (1 search per click).
MAX_PRODUCT_PAGES=0

# Optional: older, slower way to find product pages via web search (0 = off, max 3).
# Each one costs a SerpAPI search and can be slow.
MAX_LINK_LOOKUPS=0

# Optional: change only when deploying online (e.g. HOST=0.0.0.0)
PORT=3000
HOST=127.0.0.1

# Optional affiliate IDs
AMAZON_TAG=
SHAREASALE_ID=
CJ_ID=
RAKUTEN_ID=
